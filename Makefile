# fanvid-qs
#   make            build fanvid
#   make install    into $(PREFIX)/bin
PREFIX  ?= /usr/local
BINDIR   = $(DESTDIR)$(PREFIX)/bin

PKGS     = libavformat libavcodec libavfilter libavutil libswscale libva libdrm \
           wayland-client
CFLAGS  ?= -O2 -g
override CFLAGS += -std=c11 -Wall -Wextra -Igen $(shell pkg-config --cflags $(PKGS))
LDLIBS   = $(shell pkg-config --libs $(PKGS)) -lm

# Wayland protocol clients, generated by wayland-scanner into gen/: from
# wayland-protocols, and wlr-layer-shell from protocols/, as no package
# installs it.
WL_PROTODIR = $(shell pkg-config --variable=pkgdatadir wayland-protocols)
WL_PROTOCOLS = \
    $(WL_PROTODIR)/stable/linux-dmabuf/linux-dmabuf-v1.xml \
    $(WL_PROTODIR)/stable/viewporter/viewporter.xml \
    $(WL_PROTODIR)/stable/xdg-shell/xdg-shell.xml \
    $(WL_PROTODIR)/staging/fractional-scale/fractional-scale-v1.xml \
    $(WL_PROTODIR)/staging/alpha-modifier/alpha-modifier-v1.xml \
    $(WL_PROTODIR)/staging/single-pixel-buffer/single-pixel-buffer-v1.xml \
    protocols/wlr-layer-shell-unstable-v1.xml
WL_GEN_H = $(patsubst %.xml,gen/%-client-protocol.h,$(notdir $(WL_PROTOCOLS)))
WL_GEN_O = $(patsubst %.xml,gen/%-protocol.o,$(notdir $(WL_PROTOCOLS)))
vpath %.xml $(sort $(dir $(WL_PROTOCOLS)))

OBJ = src/main.o src/play.o src/still.o

all: fanvid

fanvid: $(OBJ) $(WL_GEN_O)
	$(CC) -o $@ $^ $(LDLIBS)

$(OBJ): src/fanvid.h $(WL_GEN_H)

gen/%-client-protocol.h: %.xml
	@mkdir -p gen
	wayland-scanner client-header $< $@

gen/%-protocol.c: %.xml
	@mkdir -p gen
	wayland-scanner private-code $< $@

gen/%-protocol.o: gen/%-protocol.c
	$(CC) -c $(CFLAGS) -o $@ $<

install: all
	install -Dm755 fanvid $(BINDIR)/fanvid

uninstall:
	rm -f $(BINDIR)/fanvid

clean:
	rm -rf gen fanvid $(OBJ)

.PHONY: all install uninstall clean
.PRECIOUS: gen/%-protocol.c
